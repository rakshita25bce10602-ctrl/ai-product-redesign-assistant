# AI Product Redesign Assistant Environment Variables
# Copy this file to .env and configure your keys

# Optional: Google Gemini API Key.
# If not provided, the application will automatically run in heuristic demo mode.
GEMINI_API_KEY=

# Backend server configuration
PORT=8000
HOST=0.0.0.0
DATABASE_PATH=database/redesign.db
ENABLE_DEMO_FALLBACK=true
