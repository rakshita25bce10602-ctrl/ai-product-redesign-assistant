# ==============================================================================
# AI Product Redesign Assistant - Environment Variables
# Copy this file to .env before starting the backend
# ==============================================================================

# Google Gemini API Key (Optional)
# If left empty, the application runs seamlessly in dynamic heuristic Demo Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_PATH=database/redesign.db

# Demo Fallback Switch
ENABLE_DEMO_FALLBACK=true

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
