# ==============================================================================
# Git Ignore - AI Product Redesign Assistant
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key

# Preserve example configs
!.env.example

# Databases & Runtime Storage
database/*.db
database/*.sqlite*
!database/.gitkeep

# Uploaded Files & Temporary Assets
backend/uploads/*
!backend/uploads/.gitkeep
temp/
tmp/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Operating System & IDE Configurations
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
